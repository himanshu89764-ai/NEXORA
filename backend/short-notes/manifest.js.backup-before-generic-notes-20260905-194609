function getBook(className, subject) {
    const cls = String(className || "").toLowerCase().replace(/[^0-9]/g, "");
    const sub = String(subject || "").toLowerCase().trim();

    if (cls === "6" && sub === "geography") {
        return NCERT_BOOKS.class6.geography;
    }

    if (cls === "7" && sub === "geography") {
        return NCERT_BOOKS.class7.geography;
    }

    if (cls === "11" && sub === "geography") {
        return NCERT_BOOKS.class11.geography;
    }

    return null;
}

